{
  "name": "sql-middle-academy",
  "version": "1.0.0",
  "description": "Интерактивный сайт для изучения SQL (уровень middle, PostgreSQL): база знаний, тренажёр с проверкой задач и песочница.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
